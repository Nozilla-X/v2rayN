<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DefaultItemExcludes>$(DefaultItemExcludes);.NET/**;Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NLog" />
    <ProjectReference Include="..\ServiceLib\ServiceLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="WebUI\src\locales\zh-CN.json" LogicalName="v2rayN.Web.Locales.zh-CN.json" />
    <EmbeddedResource Include="WebUI\src\locales\zh-TW.json" LogicalName="v2rayN.Web.Locales.zh-TW.json" />
    <EmbeddedResource Include="WebUI\src\locales\en-US.json" LogicalName="v2rayN.Web.Locales.en-US.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ServiceLibBin\.keep"
             Link="bin\.keep"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
